# Leave blank on web; native development derives your LAN host automatically.
# Set this explicitly for a tunnel, a physical device or a deployed API.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_SIMULATION_MODE=true
EXPO_PUBLIC_DEMO_TOKEN=demo:student
# Optional Clerk key. When set, Clerk auth is used instead of demo auth.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
